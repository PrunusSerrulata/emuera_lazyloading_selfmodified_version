@ORACLE_EXTENSIONS
ORACLE_FLOAT = 1.25 + 2.5
ORACLE_SPARSE:999999 = 42
RESULT:60 = ORACLE_SPARSE:500000
RETURN

@ORACLE_FLOAT_METHOD(ARGF)
#FUNCTIONF
RETURNF ARGF * 2.0

@ORACLE_ARGUMENTS(ARG, ARGS)
RESULTS = %ARGS%
RETURN ARG + 1

@ORACLE_NF
TINPUTSNF 100000, "timeout", 0
RESULTS:60 = %RESULTS%
RETURN

@ORACLE_SEQUENCE
RESULT = SEQUENCEINPUT("17")
INPUT
RESULT:61 = RESULT
RETURN

@ORACLE_LOOP
WHILE 1
    FLAG:0 += 1
WEND
RETURN

@ORACLE_ERROR
THROW ORACLE_EXPLICIT_ERROR
RETURN
